# Tranga-Plus settings. Copy this file to ".env" (next to docker-compose.yaml) and change the values.
# Unraid: paste the lines below into Compose Manager → Edit Stack → ENV FILE instead.
# Keep .env private: it holds the database password. Never commit it to git.

# Database password. For a NEW install, set it before the first start.
# For an existing install, change it inside the database first (see README → "Change the database password").
POSTGRES_PASSWORD=change-me-to-something-long

# Time zone (log times, backup hour)
TZ=Europe/London

# Backups: hour of the day (0-23) and how many days to keep
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=7

# User and group that own downloaded files (id -u / id -g; Unraid: 99 and 100)
UID=1000
GID=1000
